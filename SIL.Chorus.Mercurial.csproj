<Project Sdk="Microsoft.NET.Sdk">

  <!-- MSBuild properties -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootDir Condition="'$(teamcity_version)' == '' Or '$(OS)'!='Windows_NT'">$(MSBuildProjectDirectory)</RootDir>
    <RootDir Condition="'$(teamcity_version)' != '' And '$(OS)'=='Windows_NT'">$(teamcity_build_checkoutDir)</RootDir>
    <teamcity_agent_home_dir Condition="'$(teamcity_agent_home_dir)'=='' And '$(OS)'!='Windows_NT'">/var/lib/TeamCity/agent</teamcity_agent_home_dir>
    <BuildCounter Condition="'$(BuildCounter)' == ''">0</BuildCounter>
    <PreRelease Condition="'$(PreRelease)' == ''">-beta.</PreRelease>
    <MercurialVersion Condition="'$(MercurialVersion)' == ''">7.0.1</MercurialVersion>
    <PackageVersion Condition="'$(PackageVersion)' == ''">$(MercurialVersion)$(PreRelease)$(BuildCounter)</PackageVersion>
  </PropertyGroup>

  <!-- NuGet properties -->
  <PropertyGroup>
    <PackageId>SIL.Chorus.Mercurial</PackageId>
    <Authors>SIL International</Authors>
    <Copyright>Copyright (c) 2020-2022 SIL International</Copyright>
    <PackageLicenseExpression>GPL-2.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sillsdev/Mercurial4Chorus</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>native</PackageTags>
    <PackageDescription>Chorus is an end-user collaboration library via 3-way xml merging and hg dvcs under the hood.

This package provides the Mercurial implementation that Chorus uses.
</PackageDescription>
    <PackageReleaseNotes>v3.0.2: explicitly request Python 2 on Linux

v3.0.3: Allow specifying an alternate destination directory using `Mercurial4ChorusDestDir`

v6.5.1: Upgrade to Mercurial 6.5.1

v7.0.1: Upgrade to Mercurial 7.0.1 and remove requirement to depend directly on this package (just depend on Chorus or LibChorus)

v7.0.2: Ship the Mercurial payload outside the runtimes/ convention path so an RID-specific `dotnet publish` no longer double-ships it (fixes NETSDK1152; consumers no longer need `ExcludeAssets="native"`)
    </PackageReleaseNotes>
    <PackageReadme>docs\README.md</PackageReadme>
  </PropertyGroup>

  <!-- What to pack -->
  <ItemGroup>
    <ReadmeFile Include="$(RootDir)\README.md" />
    <LinuxArtifacts Include="$(RootDir)\linux-x64\**\*.*" />
    <WinArtifacts Include="$(RootDir)\win\**\*.*" />
    <Extensions Include="$(RootDir)\MercurialExtensions\**\*.*" />
    <!-- Not needed when `dotnet pack` is running the show: -->
    <!-- <NuSpecFile Include="$(RootDir)\assets\*.nuspec" /> -->
    <TargetFile Include="$(RootDir)\assets\*.targets" />
  </ItemGroup>

  <!-- Where to put things.
       The Mercurial tree is staged under a plain payload/ folder rather than the
       runtimes/<rid>/native/ NuGet convention path on purpose: that convention path
       makes `dotnet publish -r <rid>` auto-copy the tree to the output, while the
       CopyFiles target in the .targets already stages it into the consumer's
       Mercurial/ folder. Shipping under runtimes/ therefore double-ships Mercurial and
       collides with NETSDK1152 under an RID-specific publish, forcing consumers to add
       ExcludeAssets="native". payload/ is inert package content, read only by our
       .targets, so neither happens. -->
  <PropertyGroup>
    <PayloadFolderWin>payload/win</PayloadFolderWin>
    <PayloadFolderLinux>payload/linux-x64</PayloadFolderLinux>
    <PayloadAnyFolder>payload/any</PayloadAnyFolder>
    <NuGetDocsFolder>docs</NuGetDocsFolder>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="@(ReadmeFile)">
      <PackagePath>$(NuGetDocsFolder)</PackagePath>
    </Content>
    <Content Include="@(LinuxArtifacts)">
      <PackagePath>$(PayloadFolderLinux)\</PackagePath>
    </Content>
    <Content Include="@(WinArtifacts)">
      <PackagePath>$(PayloadFolderWin)\</PackagePath>
    </Content>
    <Content Include="@(Extensions)">
      <PackagePath>$(PayloadAnyFolder)\MercurialExtensions\</PackagePath>
    </Content>
    <!-- Note the buildTransitive\ below. Hopefully this will allow packages to only consume Chorus and not have to consume SIL.Chorus.Mercurial directly. -->
    <Content Include="@(TargetFile)">
      <PackagePath>build;buildMultiTargeting;buildTransitive</PackagePath>
    </Content>
    <!-- Not needed when `dotnet pack` is running the show: -->
    <!-- <Content Include="@(NuSpecFile)">
      <PackagePath>\</PackagePath>
    </Content> -->
  </ItemGroup>
</Project>
