root = true

# Defaults
[*]
indent_style = tab
indent_size = tab
tab_width = 4
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = false
max_line_length = 98

[*.cs]
indent_style = tab
tab_width = 4

# Settings Visual Studio uses for the generated files
[*.{csproj,proj,resx,settings,vcxproj*,vdproj,xml,yml}]
indent_style = space
indent_size = 2

# Python, both the build scripts here and the Mercurial sources in the payloads
[*.py]
indent_style = space
indent_size = 4

# ...except the vendored fixutf8 extension, which is tab-indented as Mercurial's
# own sources were when it was written
[MercurialExtensions/**.py]
indent_style = tab
tab_width = 4

# Generated file
[*.sln]
end_of_line = crlf
